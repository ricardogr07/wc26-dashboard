# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit it.
# Used by docker-compose to inject secrets into the api container.

COSMOS_CONNECTION_STRING=AccountEndpoint=https://YOUR_ACCOUNT.documents.azure.com:443/;AccountKey=YOUR_KEY==;
COSMOS_DATABASE_NAME=wc26db
COSMOS_CONTAINER_NAME=items
ADMIN_API_KEY=your-admin-key-here
THESPORTSDB_API_KEY=your-thesportsdb-api-key
THESPORTSDB_LEAGUE_ID=4429
THESPORTSDB_SEASON=2026-2027
TIMER_SCHEDULE=0 0 * * * *
SYNC_INTERVAL_HOURS=1
