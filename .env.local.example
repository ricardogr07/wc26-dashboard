# Copy this file to .env.local and fill in your values.
# .env.local is gitignored; never commit it.
# Used by docker-compose to inject secrets into the api container.

COSMOS_CONNECTION_STRING=AccountEndpoint=https://YOUR_ACCOUNT.documents.azure.com:443/;AccountKey=YOUR_KEY==;
COSMOS_DATABASE_NAME=wc26db
COSMOS_CONTAINER_NAME=items
ADMIN_API_KEY=your-admin-key-here
THESPORTSDB_API_KEY=your-thesportsdb-api-key
THESPORTSDB_LEAGUE_ID=4429
THESPORTSDB_SEASON=2026-2027
TIMER_SCHEDULE=0 0 * * * *
SYNC_INTERVAL_HOURS=1

# Azurite (local Azure Storage emulator) connection string.
# The key below is the well-known default Azurite account key; safe for local dev only.
AzureWebJobsStorage=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OKMbbaGv+VNFCGFebAb+wGJCCR3Xe3e5V6Ia9qe3v9a==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;
